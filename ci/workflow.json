{
  "land": true,
  "attest": true,
  "release": true,
  "compile_once": true,
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-windows-gnu",
    "aarch64-windows-gnu",
    "x86_64-macos",
    "aarch64-macos"
  ],
  "jobs": [
    {
      "name": "Contracts (values)",
      "step": "contracts-values",
      "tiers": ["fast", "merge", "release"],
      "setup": false
    },
    {
      "name": "Contracts (choices)",
      "step": "contracts-choices",
      "tiers": ["fast", "merge", "release"],
      "setup": false
    },
    {
      "name": "Contracts (published)",
      "step": "contracts-published",
      "tiers": ["fast", "merge", "release"],
      "setup": false
    },
    {
      "name": "Linux targeted thread sanitizer",
      "step": "test-native-races",
      "args": ["-Dthread-sanitizer=true", "-Dci-lint=false"],
      "setup": false
    },
    {
      "name": "ThreadSanitizer (Linux)",
      "step": "test",
      "args": ["-Dthread-sanitizer=true", "-Doptimize=debug", "-Dci-lint=false"],
      "tiers": ["release"]
    }
  ]
}
