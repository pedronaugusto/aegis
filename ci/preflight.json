{
  "sources": [
    "src"
  ],
  "glint": {
    "rules": [{"id": "Z026", "level": "gate"}]
  },
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "test_dependencies": [
    "shakedown",
    "material"
  ],
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "aegis"
      ]
    },
    "zig build docs -- state": {
      "source": "examples/state.zig",
      "region": "state",
      "imports": [
        "aegis"
      ]
    },
    "zig build docs -- scope": {
      "source": "examples/scope.zig",
      "region": "scope",
      "imports": [
        "aegis"
      ]
    }
  }
}
