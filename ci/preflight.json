{
  "sources": [
    "src"
  ],
  "glint": {
    "rules": [{"id": "P001", "level": "gate"}, {"id": "P003", "level": "gate"}, {"id": "Z026", "level": "gate"}]
  },
  "test_roots": [
    "src/root.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "test_dependencies": [
    "shakedown",
    "material"
  ],
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "std",
        "aegis"
      ]
    },
    "zig build docs -- state": {
      "source": "examples/state.zig",
      "region": "state",
      "imports": [
        "aegis"
      ]
    },
    "zig build docs -- scope": {
      "source": "examples/scope.zig",
      "region": "scope",
      "imports": [
        "aegis"
      ]
    }
  },
  "extra_checks": [["zig", "build", "check-timing"]]
}
